[Unit]
Description=Prispect evidence service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cashlens
Group=cashlens
WorkingDirectory=/opt/cashlens/current
EnvironmentFile=/etc/cashlens.env
ExecStart=/usr/local/bin/node --import tsx server/index.ts
Restart=on-failure
RestartSec=5
TimeoutStopSec=120
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cashlens
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=1G

[Install]
WantedBy=multi-user.target
