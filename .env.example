HOST=127.0.0.1
PORT=4317
CASHLENS_DATA_DIR=.cashlens
NODE_ENV=development
# Production requires the actual HTTPS origin, e.g. https://xuejun.cc.
# In development, leave this empty to allow the local 4317/4318 origins.
APP_ORIGIN=
TRUST_PROXY=false

# Optional: the application runs real rule-based analysis without a model API.
# Configure only credentials authorized for this project. Never use VITE_ for secrets.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
LLM_TIMEOUT_MS=60000
