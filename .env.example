HOST=127.0.0.1
PORT=4317
CASHLENS_DATA_DIR=.cashlens
NODE_ENV=development
# Registration is open by default in production and development.
# Set false to temporarily close signup, or true to explicitly open it; restart after changes.
CASHLENS_REGISTRATION_ENABLED=
# Production requires the actual HTTPS origin, e.g. https://prispect.com.
# In development, leave empty and use http://localhost:4318 for passkeys.
# 127.0.0.1 remains allowed for ordinary local API requests, but is not a valid WebAuthn RP domain.
APP_ORIGIN=
TRUST_PROXY=false

# New queries, company questions and report explanations use the configured model.
# Without a model API, retain real rule-based results and report the unavailable status.
# Configure only credentials authorized for this project. Never use VITE_ for secrets.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://tokenflux.dev/v1
OPENAI_MODEL=grok-4.7-fast
LLM_TIMEOUT_MS=60000

# Required in production: independent random secret (32+ characters).
# Back up this secret separately; changing it can invalidate sessions and encrypted 2FA data.
# Development without this variable creates a private persistent CASHLENS_DATA_DIR/auth-secret.
BETTER_AUTH_SECRET=

# Optional SMTP. All four values are required; otherwise verification/change/recovery
# report unavailable and no mail is sent. Do not configure placeholders as working services.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Display phone numbers need no SMS provider. Legacy SMS APIs remain unavailable.
# No fake OTP, verified phone flag, or implicit SMS credentials are supported.
