{
  "name": "prispect",
  "private": true,
  "scripts": {
    "prebuild": "node scripts/notices.mjs",
    "notices": "node scripts/notices.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:server": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "dev:web": "vite --host 127.0.0.1 --port 4318 --strictPort",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build && npm run format:check",
    "data:fetch": "node scripts/fetch-sources.mjs",
    "data:samples": "node scripts/sample-inputs.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/cli": "0.1.21",
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "26.6.3",
    "@types/nodemailer": "8.0.2",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "3.6.2",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@better-auth/passkey": "1.7.7",
    "@gsap/react": "2.1.2",
    "@langchain/core": "1.1.48",
    "@langchain/langgraph": "1.4.18",
    "@langchain/langgraph-checkpoint-sqlite": "1.0.4",
    "@zxcvbn-ts/core": "4.2.0",
    "@zxcvbn-ts/language-common": "4.1.3",
    "@zxcvbn-ts/language-en": "4.1.1",
    "better-auth": "1.7.7",
    "better-call": "1.4.0",
    "better-sqlite3": "13.0.3",
    "express": "5.2.1",
    "gsap": "3.15.0",
    "libphonenumber-js": "1.13.14",
    "lucide-react": "1.49.0",
    "multer": "2.4.0",
    "nodemailer": "10.0.13",
    "papaparse": "5.7.0",
    "pdf-parse": "2.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-qr-code": "2.2.0",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "zod": "4.6.5"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  }
}
